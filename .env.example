# Strava API app (strava.com/settings/api). Never commit real values.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when verifying the webhook.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Public URL of the app (http://localhost:3000 in development).
APP_URL=http://localhost:3000

# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Shared secret for the background sync endpoint (/api/cron/sync).
CRON_SECRET=

# Database. Locally this is a file; in production a Turso (libSQL) URL + token.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Strava athlete IDs (comma-separated) who are admins.
ADMIN_STRAVA_IDS=
